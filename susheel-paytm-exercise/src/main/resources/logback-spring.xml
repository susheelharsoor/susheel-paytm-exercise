<?xml version="1.0" encoding="UTF-8"?>
<configuration>


    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="wallet-service"/>

    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Keep the standard fields; add app name for easy filtering -->
            <customFields>{"app":"${appName}"}</customFields>
            <!-- Shorten the logger name to avoid noise -->
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
        </encoder>
    </appender>

    <!-- Root logger: INFO to JSON stdout -->
    <root level="INFO">
        <appender-ref ref="JSON_STDOUT"/>
    </root>

    <!-- Quieten chatty Spring/Hibernate internals -->
    <logger name="org.springframework"           level="WARN"/>
    <logger name="org.hibernate"                 level="WARN"/>
    <logger name="com.zaxxer.hikari"             level="WARN"/>
    <logger name="org.springframework.web.servlet.DispatcherServlet" level="INFO"/>

    <!-- Our application code stays at INFO -->
    <logger name="com.paytm.wallettransfer" level="INFO"/>

</configuration>
